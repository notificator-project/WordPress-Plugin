{
	"compilerOptions": {
		"target": "ES2020",
		"lib": ["DOM", "ES2020"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": false,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vite/client", "node"]
	},
	"include": [
		"assets/src/**/*.ts",
		"assets/src/**/*.d.ts",
		"assets/js/**/*.ts",
		"vite*.config.ts",
		"tailwind.config.ts"
	],
	"exclude": ["assets/dist"]
}
